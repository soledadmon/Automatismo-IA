    {
      "parameters": {
        "jsCode": "// Obtener texto generado por la IA\nlet texto = $json.output[0].content[0].text;\n\n// Quitar formato Markdown del JSON\ntexto = texto\n  .replace(/```json/g, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\n// Convertir texto a objeto JSON\nconst dashboard = JSON.parse(texto);\n\n\n// Preparar datos para Dashboard_IA\n\nreturn [\n  {\n    json: {\n      Fecha: new Date().toISOString(),\n\n      Total_Tickets: dashboard.total_tickets || 0,\n\n      Tickets_Resueltos: dashboard.tickets_resueltos || 0,\n\n      Tickets_Pendientes: dashboard.tickets_pendientes || 0,\n\n      Tickets_Con_Alertas: dashboard.tickets_con_alertas || 0,\n\n      Tiempo_Promedio_Resolucion:\n        dashboard.tiempo_promedio_resolucion || \"\",\n\n      Categorias_Mas_Frecuentes:\n        dashboard.categorias_mas_frecuentes.join(\", \"),\n\n      Problemas_Recurrentes:\n        dashboard.problemas_recurrentes.join(\", \"),\n\n      Riesgos_Detectados:\n        dashboard.riesgos_detectados.join(\", \"),\n\n      Recomendaciones_IA:\n        dashboard.recomendaciones_mejora.join(\", \")\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
