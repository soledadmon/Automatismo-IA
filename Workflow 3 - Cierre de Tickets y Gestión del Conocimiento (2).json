        "jsCode": "const texto = $json.output[0].content[0].text\n  .replace(/```json/g, '')\n  .replace(/```/g, '')\n  .trim();\n\nconst respuesta = JSON.parse(texto);\n\nreturn [\n  {\n    json: respuesta\n  }\n];"
